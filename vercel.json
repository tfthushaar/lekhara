{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "services": {
    "web": {
      "root": "web/",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "api", "format": "url", "env": "LEKHARA_API_URL" }]
    },
    "api": {
      "root": "api/",
      "framework": "fastapi",
      "entrypoint": "lekhara.vercel:app"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }],
  "crons": [{ "path": "/api/demo-reset", "schedule": "30 21 * * *" }]
}
